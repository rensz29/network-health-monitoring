FORTIGATE_HOST=10.156.116.20
FORTIGATE_TOKEN=your-rest-api-token
# FortiGate ships with a self-signed certificate; set to false once a trusted cert is installed.
FORTIGATE_INSECURE_TLS=true
FORTIGATE_TIMEOUT_MS=15000
PORT=3000
# How often the servers you added are pinged (milliseconds). Down after 2 missed replies.
HEALTH_INTERVAL_MS=10000
# Where custom device names/servers are stored (default: server/data/custom-devices.json).
# Give each running instance its own file; they must not share one.
# CUSTOM_DEVICES_FILE=data/custom-devices.json
